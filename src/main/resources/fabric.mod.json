  "authors": ["petch"],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": ["petch.litematica_autorotate.AutoRotateClient"]
  },
  "mixins": ["litematica_autorotate.mixins.json"],
  "depends": {
    "java": ">=25",
    "minecraft": "~26.2",
    "fabricloader": ">=0.19.0",
    "litematica": ">=0.28.0- <0.29.0-",
    "malilib": ">=0.29.0- <0.30.0-",
    "fabric-lifecycle-events-v1": "*"
  },
  "custom": {
    "modmenu": { "parent": "litematica" }
  }
}
